# Browser origin allowed to call the API Worker (CORS).
# Local Alchemy Vite: http://localhost:5173
# Production deploy requires exactly https://keynest.me
CORS_ORIGIN=http://localhost:5173

# Signs the session cookie. At least 32 characters.
# Generate with: openssl rand -hex 32
COOKIE_SECRET=

# Required for a production deploy. When both are set, signup and email
# changes wait for a confirmation link. Local development without these
# signs you in immediately.
# EMAIL_FROM="Keynest <mail@example.com>"
# RESEND_API_KEY=
