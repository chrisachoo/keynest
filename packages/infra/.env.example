# Browser origin allowed to call the API Worker (CORS).
# Local Alchemy Vite: http://localhost:5173
# Production: the deployed web Worker URL
CORS_ORIGIN=http://localhost:5173

# Signs the session cookie. At least 32 characters.
# Generate with: openssl rand -hex 32
COOKIE_SECRET=

# Optional. When both are set, signup and email changes wait for a confirmation link.
# Local development without these signs you in immediately and prints nothing.
# EMAIL_FROM="Keynest <mail@example.com>"
# RESEND_API_KEY=
