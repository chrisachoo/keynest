{
	"name": "keynest",
	"private": true,
	"description": "Private home for your digital keys.",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@cloudflare/workers-types": "^5.20260920.1",
			"@hono/standard-validator": "^0.4.0",
			"@scalar/hono-api-reference": "^0.12.3",
			"@t3-oss/env-core": "^0.13.10",
			"@types/bun": "^1.4.2",
			"@valibot/to-json-schema": "^1.8.0",
			"drizzle-orm": "1.0.0-rc.4",
			"hono-openapi": "^1.3.3",
			"hono": "^4.13.7",
			"typescript": "^6.0.3",
			"valibot": "^1.5.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev -F @keynest/infra",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"db:generate": "turbo run db:generate -F @keynest/db --",
		"db:studio": "turbo run db:studio -F @keynest/db --",
		"deploy": "turbo run deploy -F @keynest/infra --",
		"destroy": "turbo run destroy -F @keynest/infra --",
		"check": "oxlint && oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix && oxfmt --write",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.86.0",
		"turbo": "^2.11.5",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*": [
			"oxlint --fix --no-error-on-unmatched-pattern",
			"oxfmt --no-error-on-unmatched-pattern"
		]
	},
	"packageManager": "bun@1.4.2"
}
